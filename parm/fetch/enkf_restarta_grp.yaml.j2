enkf_restarta_grp:
    name: "ENKF_RESTARTA_GRP"
    target:
        tarball: "{{ FETCHDIR }}/{{ cycle_YMDH }}/{{ RUN }}_restarta_grp{{ ENSGRP }}.tar"
        on_hpss: True
        contents:
            {% for mem in range(first_group_mem, last_group_mem + 1) %}
            {% set imem = mem - first_group_mem %}
            # Construct the pertinent member COM directories
            {% set COMIN_ATMOS_ANALYSIS_MEM = COMIN_ATMOS_ANALYSIS_MEM_list[imem] %}
            {% set COMIN_ATMOS_HISTORY_MEM = COMIN_ATMOS_HISTORY_MEM_list[imem] %}
            {% set COMIN_ATMOS_RESTART_MEM = COMIN_ATMOS_RESTART_MEM_list[imem] %}

            # Member surface analysis data
            {% if DOIAU_ENKF %}
                {% set anl_delta = "-3H" | to_timedelta %}
            {% else %}
                {% set anl_delta = "0H" | to_timedelta %}
            {% endif %}
            {% set anl_time = current_cycle | add_to_datetime(anl_delta) %}
            {% for itile in range(1, 7) %}
            - "{{ COMIN_ATMOS_RESTART_MEM | relpath(ROTDIR) }}/{{ anl_time | to_YMD }}.{{ anl_time | strftime("%H") }}0000.sfcanl_data.tile{{ itile }}.nc"
            {% endfor %}


            # Member atmospheric increments or analysis data
            {% if DO_JEDIATMENS %}
                {% for iaufhr in iaufhrs_str %}
                    {% for itile in range(6) %}
                        {% if DOENKFONLY_ATM %}
            - "{{ COMIN_ATMOS_ANALYSIS_MEM | relpath(ROTDIR) }}/{{ head }}jedi_increment.atm.i{{ iaufhr }}.tile{{ itile+1 }}.nc"
                        {% else %}
            - "{{ COMIN_ATMOS_ANALYSIS_MEM | relpath(ROTDIR) }}/{{ head }}recentered_jedi_increment.atm.i{{ iaufhr }}.tile{{ itile+1 }}.nc"
                        {% endif %}
                    {% endfor %}
                {% endfor %}
            {% else %}
                {% for iaufhr in iaufhrs_str %}
                    {% if do_calc_increment %}
            - "{{ COMIN_ATMOS_ANALYSIS_MEM | relpath(ROTDIR) }}/{{ head }}analysis.atm.a{{ iaufhr }}.nc"
                    {% else %}
                        {% if not DOENKFONLY_ATM %}
            - "{{ COMIN_ATMOS_ANALYSIS_MEM | relpath(ROTDIR) }}/{{ head }}recentered_increment.atm.i{{ iaufhr }}.nc"
                        {% endif %}
                    {% endif %}
                {% endfor %}  # iaufhr in iaufhrs_str
            {% endif %}

            {% endfor %}  # first_group_mem to last_group_mem
        destination: "{{ ROTDIR }}"
