#! /usr/bin/env bash

########## config.getic ##########
# Fetching GFS initial conditions specific

echo "BEGIN: config.getic"

# Get task specific resources
. $EXPDIR/config.resources getic

export REDUCEDRES="NO" # YES = Pull gfs reduced resolution parallel run
export ICFROM=${ICFROM:-"gfs"}
export RETRO="NO" # YES = Pull gfs inputs from retrospective parallels; NO = use operational inputs
export ICDUMP=${ICDUMP:-"gdas"}
export START="cold"
export OPS_RES=${OPS_RES:-"C768"} # Operational resolution

export UFS_DIR=${HOMEgfs}/sorc/ufs_utils.fd
export GDASINIT_DIR=${UFS_DIR}/util/gdas_init

export PRODHPSSDIR=/NCEPPROD/hpssprod/runhistory
export gfs_ver=${gfs_ver:-"v16"}
export exp_ver=${exp_ver:-"2024"}
export GETICSH=${GDASINIT_DIR}/get_v16.data.sh

if [[ $CDATE -lt 2021032106 && ${RETRO:-"NO"} != "YES" ]]; then # Retrospective parallel input
  export GETICSH=${GDASINIT_DIR}/get_v16retro.data.sh
  if [[ $CDATE -lt 2019060106 ]]; then
    export HPSSDIR=/NCEPDEV/emc-global/5year/emc.glopara/WCOSS_D/gfsv16/v16retro0e
  elif [[ $CDATE -lt 2019090100 ]]; then
    export HPSSDIR=/NCEPDEV/emc-global/5year/emc.glopara/WCOSS_D/gfsv16/v16retro1e
  elif [[ $CDATE -lt 2019101706 ]]; then
    export HPSSDIR=/NCEPDEV/emc-global/5year/emc.glopara/WCOSS_D/gfsv16/v16retro2e
  elif [[ $CDATE -lt 2020122200 ]]; then
    export HPSSDIR=/NCEPDEV/emc-global/5year/emc.glopara/WCOSS_D/gfsv16/v16rt2
  elif [[ $CDATE -le 2021032506 ]]; then
    export HPSSDIR=/NCEPDEV/emc-global/5year/emc.glopara/WCOSS_D/gfsv16/v16rt2n
  else
    set +x
    echo NO DATA FOR $CDATE
    exit 3
  fi
else # Operational input
  # No ENKF data prior to 2012/05/21/00z
  if [[ $CDATE -lt 2012052100 ]]; then
    set +x
    echo FATAL ERROR: SCRIPTS DO NOT SUPPORT OLD GFS DATA
  elif [[ $CDATE -lt 2016051000 ]]; then
    export gfs_ver="v12"
    export GETICSH=${GDASINIT_DIR}/get_pre-v14.data.sh
  elif [[ $CDATE -lt 2017072000 ]]; then
    export gfs_ver="v13"
    export GETICSH=${GDASINIT_DIR}/get_pre-v14.data.sh
  elif [[ $CDATE -lt 2019061200 ]]; then
    export gfs_ver="v14"
    export GETICSH=${GDASINIT_DIR}/get_${gfs_ver}.data.sh
  elif [[ $CDATE -lt 2021032100 ]]; then
    export gfs_ver="v15"
    export GETICSH=${GDASINIT_DIR}/get_${gfs_ver}.data.sh
  elif [[ $CDATE -lt 2021032106 ]]; then
    # The way the v16 switch over was done, there is no complete
    # set of v16 or v15 data for 2021032100.  And although
    # v16 was officially implemented 2021032212, the v16 prod
    # tarballs were archived starting 2021032106.
    set +x
    echo FATAL ERROR: NO V15 OR V16 DATA FOR 2021032100
    exit 1
  fi
fi

if [[ "$ICFROM" != "gfs" ]]; then
   GETICSH=$HOMEgfs/ush/get_exp_ic.sh
fi

if [[ "$ICFROM" == "gfs" ]]; then
   if [[ $CDATE -ge 2022112900 ]]; then
     export gfssubver="v16.3"
   elif [[ $CDATE -ge 2022062700 ]]; then
     export gfssubver="v16.2"
   else
     export gfssubver="prod"
   fi
fi

if [[ "$MODE" = "replay" && $REPLAY_4DIAU = "NO" ]]; then 
   export IAUFHRS="6"
fi

export HPSSEXPDIR=${ATARDIR}/../

echo "END: config.getic"
