#! /usr/bin/env bash

########## config.eupp ##########
# Ensemble UPP specific

echo "BEGIN: config.eupp"

# Get task specific resources
source "${EXPDIR}/config.resources" eupp

export UPP_CONFIG="${PARMglobal}/post/upp.yaml"
export NET="gfs"

# No. of forecast hours to process in a single job
export NFHRS_PER_GROUP=1

export eupp_fhr=6

echo "END: config.eupp"
