#! /usr/bin/env bash

########## config.efetch ##########
# Ensemble fetch specific

echo "BEGIN: config.efetch"

# Get task specific resources
source "${EXPDIR}/config.resources" fetch

if [[ ${MODE} == "ensregrid" ]]; then
   export EFHMIN=6
   export EFHMAX=6
else
   export EFHMIN=3
   export EFHMAX=9
fi

export SAVEDIR=${ENSDIR}

echo "END: config.efetch"
